# ==========================================
# TaskFlow - Production .gitignore
# ==========================================

# Dependencies
node_modules/
jspm_packages/
web_modules/

# Build Output
dist/
build/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime
pids/
*.pid
*.pid.lock
*.seed

# Environment Variables
.env
.env.*
!.env.example

# SQLite Database
database.sqlite
server/database.sqlite
*.sqlite
*.sqlite3
*.db

# Antigravity IDE
.agents/

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm

# TypeScript
*.tsbuildinfo

# Package Archives
*.tgz

# IDE
.vscode/
!.vscode/extensions.json
.idea/
.vscode-test/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# Next.js
.next/
out/

# Nuxt
.nuxt/
.output/

# SvelteKit
.svelte-kit/

# VuePress
.vuepress/dist
.temp/

# Docusaurus
.docusaurus/

# Serverless
.serverless/

# Firebase
.firebase/

# DynamoDB Local
.dynamodb/

# FuseBox
.fusebox/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity
.pnp.*

# pnpm
.pnpm-store/

# Miscellaneous
.lock-wscript
.node_repl_history
report.*.json
lib-cov/
build/Release/

# Optional Test Files
*.lcov